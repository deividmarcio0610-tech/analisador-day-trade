# VISION CODE — remote GPU configuration
#
# Copy to `.env.local` and fill in the values from your GPU host.
# `.env.local` is git-ignored. The API key is read on the server only and is
# never sent to the browser or written to the database.

# Base URL of the model server running on the GPU.
#   Ollama            → http://<host>:<port>            (e.g. .../11434)
#   vLLM / OpenAI API → http://<host>:<port>/v1
# The platform probes /api/tags, /models and /v1/models and uses whichever
# answers, so either form works.
VISION_AI_BASE_URL=

# Exact model ids as served by that endpoint (`ollama list` or GET /v1/models).
# Nothing is guessed: an empty value is reported as NOT CONFIGURED.
VISION_QWEN_MODEL=
VISION_DEEPSEEK_MODEL=

# Completion timeout in milliseconds (default 600000, min 1000, max 3600000).
VISION_AI_TIMEOUT=600000

# Bearer token, if the endpoint is behind a gateway that requires one.
# Leave empty for a private instance reachable over an SSH tunnel.
VISION_AI_API_KEY=

# ---------------------------------------------------------------------------
# Optional: workspace and local providers
# ---------------------------------------------------------------------------
# VISION_WORKSPACE_ROOT=/path/to/project
# VISION_DATA_DIR=/path/to/project/.vision
# OLLAMA_BASE_URL=http://127.0.0.1:11434
